# Copy to .env and fill in. .env is gitignored.

# Required: ONE of the two credentials below (see `auth:` in config/fleet.yaml)
# a) Claude API key, billed per use (https://console.anthropic.com/)
ANTHROPIC_API_KEY=
# b) Your own Claude subscription (Pro/Max): run `claude setup-token` and paste the 1-year token.
#    When this is used, ANTHROPIC_API_KEY is ignored so runs are never billed to the API by accident.
CLAUDE_CODE_OAUTH_TOKEN=

# Optional: Slack Incoming Webhook for run reports / action items
SLACK_WEBHOOK_URL=

# Optional: secrets referenced from config/mcp.json as ${VAR}
SLACK_MCP_URL=
SLACK_MCP_TOKEN=
GMAIL_OAUTH_TOKEN=

# Optional: web dashboard (`nakama ui` / `serve --ui`). Needed only when opening it from other devices.
NAKAMA_UI_PASSWORD=
# Extra hostnames allowed in the Host header, comma separated (e.g. nas.local,192.168.1.20)
NAKAMA_UI_ALLOW_HOSTS=

# Container only: match your host user so bind-mounted files stay yours (Linux/WSL/NAS: `id -u` / `id -g`)
# Synology DSM users are typically UID=1026 GID=100. Check over SSH with `id`.
UID=1000
GID=1000
TZ=Asia/Tokyo

# Optional: Teams "Workflows" webhook (Teams > ワークフロー > Webhook 要求を受信したらチャットに投稿する)
TEAMS_WEBHOOK_URL=

# Optional: Tailscale sidecar (compose.override.example.yaml). Auth key from the admin console
# (Settings > Keys > Generate auth key; not reusable, not ephemeral). Used only on the first start.
TS_AUTHKEY=
# Machine name in your tailnet -> https://<TS_HOSTNAME>.<tailnet>.ts.net
TS_HOSTNAME=nakama
